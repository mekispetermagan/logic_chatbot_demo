# Optional LLM interpretation (use your own key).
OPENAI_API_KEY=

# Optional, local-only Google Calendar MCP integration.
# Replace paths for your machine. Keep credentials and tokens outside the repo.
LOGIC_CHATBOT_CALENDAR_ENABLED=false
LOGIC_CHATBOT_CALENDAR_WRITES_ENABLED=false
LOGIC_CHATBOT_CALENDAR_NODE=node
LOGIC_CHATBOT_CALENDAR_MCP_PATH=/absolute/path/to/calendar-mcp/node_modules/@cocal/google-calendar-mcp/build/index.js
GOOGLE_OAUTH_CREDENTIALS=/absolute/path/to/google-calendar/oauth-client.json
GOOGLE_CALENDAR_MCP_TOKEN_PATH=/absolute/path/to/google-calendar/tokens.json
LOGIC_CHATBOT_CALENDAR_ACCOUNT=demo
LOGIC_CHATBOT_CALENDAR_ID=logic.engine.demo@gmail.com
