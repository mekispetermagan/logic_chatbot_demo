cabal-version: 3.0
name: logic-engine
version: 0.1.0.0
build-type: Simple

library
  other-modules: ControlledLanguage.Grammar, ControlledLanguage.Canonical,
                 ControlledLanguage.CanonicalPretty
  exposed-modules: Ontology, Domain, DomainLibrary,
                   Domains.Calendar.Language, Domains.Calendar.Types, Domains.Calendar.Language.Syntax,
                   Domains.Calendar.Language.Parser, Domains.Calendar.Language.Pretty,
                   Domains.Calendar.Language.State, Domains.Calendar.Language.Resolution,
                   Domains.Calendar.Language.Planning, Domains.Calendar.Language.Queries,
                   Domains.Calendar.Language.Evaluation,
                   Domains.Cellular.Types, Domains.Cellular.Evaluation, Domains.Cellular.Language,
                   Domains.Cellular.Language.Syntax, Domains.Cellular.Language.Parser,
                   Domains.Cellular.Language.Pretty, Domains.Cellular.Language.Evaluation,
                   ControlledLanguage.Domain, ControlledLanguage.Discourse, ControlledLanguage.Syntax, ControlledLanguage.Parser, ControlledLanguage.Pretty, ControlledLanguage.Evaluation,
                   Domains.Network.Language, Domains.Network.Language.Parser, Domains.Network.Language.Evaluation,
                   Domains.Network.Analysis,
                   Domains.Objects.Definition, Domains.Objects.Vocabulary,
                   Domains.Objects.Parser, Domains.Objects.Evaluation, Domains.Objects.Library,
                   Domains.Objects.Language, Domains.Objects.Language.Syntax, Domains.Objects.Language.Parser,
                   Domains.Objects.Language.Pretty, Domains.Objects.Language.Evaluation,
                   Domains.Objects.Language.Grammar, Domains.Objects.Language.Canonical,
                   Domains.Objects.Language.CanonicalPretty,
                   Domains.Network.Definition, Domains.Network.Library, Domains.Network.Sandbox,
                   Domains.Network.Pathfinding,
                   Domains.Network.Syntax, Domains.Network.Patterns, Domains.Network.Graph,
                   Domains.Network.Parser, Domains.Network.Evaluation,
                   Grammar, Pretty, Result, Sandbox, Console, ReferenceResolution,
                   AtomicPerformative, AtomicPropertyCheck, AtomicPropertyQuery, AtomicSquareCheck,
                   AtomicSentence, AtomicParser, AtomicEvaluation, WorldEditor,
                   SyntaxVocabulary, Layer2Syntax, Layer2Parser, Discourse,
                   Layer2Evaluation, Layer3Evaluation
  hs-source-dirs: .
  build-depends: base >=4.14 && <5, megaparsec >=9 && <10, containers, mtl, aeson >=2 && <3, time, text, bytestring
  default-language: Haskell2010
  default-extensions: InstanceSigs

executable logic-engine-editor
  main-is: Main.hs
  other-modules: EditorJson, CellularJson
  hs-source-dirs: bridge
  build-depends: base >=4.14 && <5, logic-engine, containers, aeson >=2 && <3, bytestring
  default-language: Haskell2010

test-suite atomic-parser-tests
  type: exitcode-stdio-1.0
  main-is: AtomicParserTest.hs
  hs-source-dirs: test
  build-depends: base >=4.14 && <5, logic-engine
  default-language: Haskell2010

