cabal-version: 3.0
name: logic-engine
version: 0.1.0.0
build-type: Simple

library
  exposed-modules: Grammar, Ontology, AtomicPerformative, AtomicPropertyCheck,
                   AtomicPropertyQuery, AtomicSentence, AtomicParser, AtomicEvaluation, ReferenceResolution,
                   Pretty, Result, Sandbox, Console, WorldEditor, Layer2Syntax, Layer2Parser, Discourse, Layer2Evaluation
  hs-source-dirs: .
  build-depends: base >=4.14 && <5, megaparsec >=9 && <10
  default-language: Haskell2010
  default-extensions: InstanceSigs

executable logic-engine-editor
  main-is: Main.hs
  other-modules: EditorJson
  hs-source-dirs: bridge
  build-depends: base >=4.14 && <5, logic-engine, aeson >=2 && <3, bytestring
  default-language: Haskell2010

test-suite atomic-parser-tests
  type: exitcode-stdio-1.0
  main-is: AtomicParserTest.hs
  hs-source-dirs: test
  build-depends: base >=4.14 && <5, logic-engine
  default-language: Haskell2010

test-suite world-editor-tests
  type: exitcode-stdio-1.0
  main-is: WorldEditorTest.hs
  other-modules: EditorJson
  hs-source-dirs: test, bridge
  build-depends: base >=4.14 && <5, logic-engine, aeson >=2 && <3
  default-language: Haskell2010

test-suite layer2-parser-tests
  type: exitcode-stdio-1.0
  main-is: Layer2ParserTest.hs
  hs-source-dirs: test
  build-depends: base >=4.14 && <5, logic-engine
  default-language: Haskell2010

test-suite layer2-evaluation-tests
  type: exitcode-stdio-1.0
  main-is: Layer2EvaluationTest.hs
  hs-source-dirs: test
  build-depends: base >=4.14 && <5, logic-engine
  default-language: Haskell2010
