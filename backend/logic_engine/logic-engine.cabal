cabal-version: 3.0
name: logic-engine
version: 0.1.0.0
build-type: Simple

library
  exposed-modules: Grammar, Ontology, AtomicPerformative, AtomicPropertyCheck,
                   AtomicPropertyQuery, AtomicSentence, AtomicParser, AtomicEvaluation, ReferenceResolution,
                   Pretty, Result, Sandbox, Console
  hs-source-dirs: .
  build-depends: base >=4.14 && <5, megaparsec >=9 && <10
  default-language: Haskell2010
  default-extensions: InstanceSigs

test-suite atomic-parser-tests
  type: exitcode-stdio-1.0
  main-is: AtomicParserTest.hs
  hs-source-dirs: test
  build-depends: base >=4.14 && <5, logic-engine
  default-language: Haskell2010
