cabal-version: 3.0
name: logic-engine
version: 0.1.0.0
build-type: Simple

library
  exposed-modules: Ontology, Domain, DomainLibrary,
                   Domains.Objects.Definition, Domains.Objects.Vocabulary,
                   Domains.Objects.Parser, Domains.Objects.Evaluation, Domains.Objects.Library,
                   Domains.Network.Definition, Domains.Network.Library, Domains.Network.Sandbox,
                   Domains.Network.Pathfinding,
                   Domains.Network.Syntax, Domains.Network.Patterns, Domains.Network.Graph,
                   Domains.Network.Parser, Domains.Network.Evaluation,
                   Grammar, Pretty, Result, Sandbox, Console, ReferenceResolution,
                   AtomicPerformative, AtomicPropertyCheck, AtomicPropertyQuery,
                   AtomicSentence, AtomicParser, AtomicEvaluation, WorldEditor,
                   SyntaxVocabulary, Layer2Syntax, Layer2Parser, Discourse,
                   Layer2Evaluation, Layer3Evaluation
  hs-source-dirs: .
  build-depends: base >=4.14 && <5, megaparsec >=9 && <10, containers
  default-language: Haskell2010
  default-extensions: InstanceSigs

executable logic-engine-editor
  main-is: Main.hs
  other-modules: EditorJson
  hs-source-dirs: bridge
  build-depends: base >=4.14 && <5, logic-engine, containers, aeson >=2 && <3, bytestring
  default-language: Haskell2010

test-suite atomic-parser-tests
  type: exitcode-stdio-1.0
  main-is: AtomicParserTest.hs
  hs-source-dirs: test
  build-depends: base >=4.14 && <5, logic-engine
  default-language: Haskell2010

test-suite world-editor-tests
  type: exitcode-stdio-1.0
  main-is: WorldEditorTest.hs
  other-modules: EditorJson
  hs-source-dirs: test, bridge
  build-depends: base >=4.14 && <5, logic-engine, containers, aeson >=2 && <3
  default-language: Haskell2010

test-suite layer2-parser-tests
  type: exitcode-stdio-1.0
  main-is: Layer2ParserTest.hs
  hs-source-dirs: test
  build-depends: base >=4.14 && <5, logic-engine
  default-language: Haskell2010

test-suite layer2-evaluation-tests
  type: exitcode-stdio-1.0
  main-is: Layer2EvaluationTest.hs
  hs-source-dirs: test
  build-depends: base >=4.14 && <5, logic-engine
  default-language: Haskell2010

test-suite layer3-tests
  type: exitcode-stdio-1.0
  main-is: Layer3Test.hs
  hs-source-dirs: test
  build-depends: base >=4.14 && <5, logic-engine
  default-language: Haskell2010

test-suite domain-tests
  type: exitcode-stdio-1.0
  main-is: DomainTest.hs
  hs-source-dirs: test
  build-depends: base >=4.14 && <5, logic-engine
  default-language: Haskell2010

test-suite network-tests
  type: exitcode-stdio-1.0
  main-is: NetworkTest.hs
  hs-source-dirs: test
  build-depends: base >=4.14 && <5, logic-engine
  default-language: Haskell2010

test-suite network-layer3-tests
  type: exitcode-stdio-1.0
  main-is: NetworkLayer3Test.hs
  hs-source-dirs: test
  build-depends: base >=4.14 && <5, logic-engine, containers
  default-language: Haskell2010

test-suite network-connection-tests
  type: exitcode-stdio-1.0
  main-is: NetworkConnectionTest.hs
  hs-source-dirs: test
  build-depends: base >=4.14 && <5, logic-engine, containers
  default-language: Haskell2010
